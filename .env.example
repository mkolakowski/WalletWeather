# Copy to .env and fill in. Do NOT commit .env.

# Postgres password (any strong random string)
DB_PASSWORD=change_me_to_something_strong

# Session cookie secret (random 32+ chars). The server won't start with it
# empty, shorter than 16 characters, or left as it is here.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace_with_random_string

# Field encryption key (Fernet key, urlsafe base64 32 bytes)
# Generate: python3 -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=replace_with_fernet_key

# --- Optional: Google OAuth ---
# Leave both blank to use local email/password login only.
# To enable Google sign-in, create OAuth credentials at
# https://console.cloud.google.com/apis/credentials with redirect URI:
#   ${APP_BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL where the app is reachable (used to build the OAuth redirect,
# and to tell the app's own pages from other sites': a change made from a
# page on another address is refused). If you open the app at more than one
# address and a reverse proxy rewrites the Host header, list the others in
# TRUSTED_ORIGINS, comma-separated, e.g. https://wallet.example.com
APP_BASE_URL=http://localhost:8300
TRUSTED_ORIGINS=

# Set to "false" to disable new account self-registration after you've created
# your initial users. Existing users can still sign in.
ALLOW_REGISTRATION=true

# Optional: a code people must type to register with an email and password.
# Registering proves nothing about who owns an address, so on an instance
# other people can reach, set this to a long random string and give it only
# to the people the instance is for. Blank = no code is asked for.
# With a code set, Google sign-in makes new users only for ALLOWED_EMAILS.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(16))"
REGISTRATION_CODE=

# Optional: comma-separated allowlist of emails permitted to register/sign in.
# Applies to BOTH local registration and Google OAuth. Leave blank to allow any email.
ALLOWED_EMAILS=

# Login rate limiting. After LOGIN_MAX_FAILURES wrong passwords for the same
# email from the same address within LOGIN_WINDOW_MINUTES, that email can't
# sign in from that address until LOGIN_WINDOW_MINUTES have passed since the
# last wrong one. A correct password before then clears the count.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
# Two wider limits in the same window: wrong passwords for one email from
# all addresses together, and from one address across all emails. And how
# many new users one address may register in an hour. Behind a reverse proxy
# every visitor shares the proxy's address unless TRUST_PROXY_HEADERS is on,
# so raise the last two there if they get in the way.
LOGIN_MAX_FAILURES_PER_EMAIL=20
LOGIN_MAX_FAILURES_PER_ADDRESS=50
REGISTRATIONS_PER_HOUR=10

# How many days the audit log (sign-ins and admin actions, Admin → Audit log)
# keeps its entries. Older ones are deleted once a day. At least 1.
AUDIT_RETENTION_DAYS=180

# Behind a Cloudflare Tunnel the server sees the tunnel's address, not the
# visitor's. Set to "true" to read the visitor's address from Cloudflare's
# CF-Connecting-IP header instead. Only turn it on when the server can be
# reached ONLY through Cloudflare: anyone who can reach port 8300 directly
# could forge the header.
TRUST_PROXY_HEADERS=false

# Optional: comma-separated list of admin emails. Admins get access to the
# Admin panel for user management, system backups, and permission overrides.
ADMIN_EMAILS=

# The passphrase that encrypts the scheduled and Admin "Run backup now"
# system backups. At least 12 characters. Without it they don't run, and
# Admin says so. You choose it yourself; nobody can recover it, so keep a
# copy somewhere other than this server: it's the only way to open those
# backups. Changing it leaves older system backups needing the old one.
BACKUP_PASSPHRASE=

# Bank sync (switched on by an admin in Admin, off by default). The only
# hosts a pasted SimpleFIN token may point the server at, comma-separated.
# Empty means SimpleFIN Bridge itself: bridge.simplefin.org and
# beta-bridge.simplefin.org. Change it only for another SimpleFIN server.
SIMPLEFIN_HOSTS=

# Bank sync through Teller (#254). Optional: without TELLER_APP_ID nobody is
# offered Teller. Make a developer account at teller.io; the application id
# (app_...) is on its dashboard and isn't a secret. TELLER_ENV is sandbox
# (made-up banks), development (your real banks, free up to 100 bank logins)
# or production. Development and production also need the client certificate
# Teller gives you: put its certificate.pem and private_key.pem in the folder
# TELLER_CERT_DIR names (default ./secrets/teller, next to this file), which
# is mounted read-only. The private key is a secret: keep it out of git.
TELLER_APP_ID=
TELLER_ENV=development
TELLER_CERT_DIR=

# Bank sync through Plaid (#254). Optional: without both keys nobody is
# offered Plaid. They're on the Keys page of dashboard.plaid.com. PLAID_ENV
# is sandbox (made-up banks, the sandbox secret) or production (your real
# banks, the production secret; the free Trial plan allows 10 bank logins).
PLAID_CLIENT_ID=
# Secret: keep it out of git.
PLAID_SECRET=
PLAID_ENV=production

# Email alerts from a Microsoft 365 or Outlook.com mailbox (#206). Optional:
# without MS_CLIENT_ID nobody can connect a mailbox. The value is the
# "Application (client) ID" of an app you register yourself, free, in
# Microsoft's Entra admin center (entra.microsoft.com → App registrations).
# docs/email-alerts.md walks through it. It isn't a secret.
MS_CLIENT_ID=
# Only for the "Connect" button, which works when APP_BASE_URL is https://:
# a client secret made under the same app's "Certificates & secrets", with
# APP_BASE_URL + /api/mail/microsoft/callback added as a Web redirect URI.
# Signing in with a code works without it. Secret: keep it out of git.
MS_CLIENT_SECRET=
# Which accounts may sign in: empty means any (personal and work or school);
# "consumers" for personal only, "organizations" for work or school only, or
# your organization's tenant id.
MS_TENANT=

# Demo mode. Off by default for real deployments. When set to "true" the
# app boots with a pre-seeded admin user (admin@demo.walletweather.local /
# demo1234) and sample accounts, recurring transactions, and actual
# postings, the UI is re-branded "WalletWeather Demo" so it's obvious the
# instance is ephemeral, and a background daemon wipes+reseeds the demo
# data hourly (but only if it's actually been edited).
# Flipping this back to "false" on the next start deletes the demo user
# and ALL data owned by any @demo.walletweather.local user. Accounts you
# created for yourself are never touched.
DEMO_MODE=false

# The largest request the server accepts, in megabytes. Raise it only if a
# backup of yours is too big to import.
MAX_BODY_MB=25
